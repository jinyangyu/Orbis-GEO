# 每台机器单独复制，不要提交、不要打进部署 zip：
#   cp .env.example .env.local
# DATABASE_URL 用这台 MySQL 的用户/密码（宝塔「数据库」面板为准）。
# 主机必须写 127.0.0.1，不要写 localhost（MySQL 会当成另一个账号）。
# 下面 orbis:orbis 只适用于本机自己建过这个用户的开发环境。
DATABASE_URL=mysql://orbis:orbis@127.0.0.1:3306/orbis

# Signed session cookie (≥32 chars). Required in production.
SESSION_SECRET=dev-local-change-me-to-a-long-random-string

# Fixed demo login gate. When BOTH are set, visitors must log in before the dashboard.
# Leave unset for open local access.
# ORBIS_GATE_USER=demo
# ORBIS_GATE_PASSWORD=change-me

# Local HTTP without HTTPS: keep cookies working on LAN IPs
ORBIS_COOKIE_SECURE=0

# --- Local demo only. Leave UNSET / 0 in production. ---
# Attach imported monitoring workspaces via POST /api/workspaces/claim.
# Ignored when NODE_ENV=production.
ORBIS_DEV_OPEN_TENANT=1

# Seed fake "detected brands" in the review modal.
# ORBIS_DEMO_DETECTED=1

# Optional: use coverage-based sentiment heuristic (default off — UI shows "—")
# ORBIS_HEURISTIC_SENTIMENT=1

# Report PDF object storage: local (default) or s3 (R2/MinIO/AWS compatible)
# REPORTS_STORAGE=local
# REPORTS_LOCAL_DIR=.data/reports
# REPORTS_STORAGE=s3
# REPORTS_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# REPORTS_S3_BUCKET=orbis-reports
# REPORTS_S3_ACCESS_KEY_ID=
# REPORTS_S3_SECRET_ACCESS_KEY=
# REPORTS_S3_REGION=auto

# Optional: Prompt Research LLM (falls back to heuristic templates if unset)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Optional: content generation agent BFF
# SEO_AGENT_BASE_URL=http://127.0.0.1:8080

# Optional: POST error payloads to a webhook (Slack/custom)
# ORBIS_ERROR_WEBHOOK_URL=

# Optional: E2E smoke base URL for `npm run test:e2e`
# ORBIS_E2E_BASE_URL=http://127.0.0.1:3000
